# Appwrite Cloud / Self-hosted API endpoint
# Default for Appwrite Cloud is https://cloud.appwrite.io/v1
VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1

# Appwrite Project ID (Found in Appwrite Console > Project Settings / Overview)
VITE_APPWRITE_PROJECT_ID=your_appwrite_project_id

# Database ID (Created under Databases in Appwrite Console)
VITE_APPWRITE_DATABASE_ID=skilltrack_db

# Table or Collection ID (Created under your Database in Appwrite Console)
VITE_APPWRITE_TABLE_ID=opportunities
